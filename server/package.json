{
  "name": "cooperativas-server",
  "version": "1.0.0",
  "description": "Backend para el sistema de gestión de cooperativas",
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp -r src/generated dist/ && mkdir -p dist/models && cp -f src/models/dev.db dist/models/dev.db 2>/dev/null || true",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "typecheck": "tsc --noEmit",
    "script:assign-invoices": "ts-node src/scripts/assign-invoices-to-coop.ts",
    "script:create-supplier": "ts-node src/scripts/create-supplier.ts",
    "script:init-invoices": "ts-node src/scripts/init-invoices.ts",
    "script:init-users": "ts-node src/scripts/init-users.ts",
    "script:migrate-data": "ts-node src/scripts/migrate-data.ts",
    "script:create-defaults": "ts-node src/scripts/create-defaults.ts",
    "prisma:generate": "prisma generate --schema=src/models/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/models/schema.prisma",
    "prisma:studio": "prisma studio --schema=src/models/schema.prisma",
    "prisma:reset": "prisma migrate reset --schema=src/models/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "sqlite3": "^5.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.0.1",
    "prisma": "^6.18.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
